{
    // DLsite 同人音声专用 Whisper 翻译生成配置
    "task": "translate",
    "language": "ja",

    // 解码质量
    "beam_size": 5,
    "best_of": 5,
    "patience": 1.0,
    "temperature": [0.0, 0.2, 0.4],

    // 【核心防幻觉】：禁用前文继承，拟音/水声/空白段绝不乱吐字
    "condition_on_previous_text": false,

    // 重复词抑制
    "repetition_penalty": 1.15,
    "no_repeat_ngram_size": 3,

    // 【DLsite专属提示词引导】：地道口语与规范简体标点
    "initial_prompt": "简体中文，DLsite同人音声作品，角色扮演情景对话，亲昵耳语、娇嗔、叹息与互动台词。",

    // DLsite 耳语专用 VAD 灵敏度
    "vad_filter": true,
    "vad_parameters": {
        "threshold": 0.40,
        "min_speech_duration_ms": 250,
        "min_silence_duration_ms": 150,
        "speech_pad_ms": 250
    }
}
